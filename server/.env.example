# Copy this file to .env and fill in real values. Never commit .env itself.
# Production startup fails fast when required values are missing, malformed,
# insecure, or still use placeholders from this file.

PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Optional error tracking. Leave blank locally; configure a separate Sentry
# project/DSN for staging and production. Traces are sampled, never request PII.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# MongoDB Atlas connection string (from your Atlas cluster)
MONGO_URI=mongodb://localhost:27017/program

# Independent secrets. Use at least 64 characters for JWT_SECRET and 32 for
# OTP_SECRET in production. Never reuse the same value. Generate either with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
OTP_SECRET=replace_with_a_different_long_random_string
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# The exact URL of your deployed frontend (no trailing slash).
# In development this is your Vite dev server.
CLIENT_URL=http://localhost:5173

# From your Cloudinary dashboard (cloudinary.com/console) — free tier is fine for MVP
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail address and Google app password used for OTP and transactional email.
# Both are required in production.
GMAIL_USER=your_account@gmail.com
GMAIL_APP_PASSWORD=replace_with_a_google_app_password

# Payouts at or above this amount require the elevated approval path.
PAYOUT_APPROVAL_THRESHOLD=5000
